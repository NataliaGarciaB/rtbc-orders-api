<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.rtbc</groupId>
	<artifactId>rtbc-orders-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>rtbc-orders-api</name>
	<description>API REST para la gestión de órdenes de compra</description>
	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
		</license>
	</licenses>
	<properties>
		<java.version>17</java.version>
		<archunit.version>1.5.1</archunit.version>
		<swagger-ui.version>5.32.14</swagger-ui.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!-- Quality gate de cobertura (ADR-011) -->
		<coverage.minimum>0.80</coverage.minimum>
		<pitest.version>1.30.1</pitest.version>
		<pitest-junit5.version>1.2.3</pitest-junit5.version>
		<!-- Quality gate de mutación (ADR-011) -->
		<mutation.threshold>70</mutation.threshold>
		<!-- -DskipUnitTests=true: solo pruebas de aceptación (contenedor de Karate, pipeline) -->
		<skipUnitTests>false</skipUnitTests>
		<!-- SonarCloud (quality gate opcional del enunciado). El token llega por la variable SONAR_TOKEN en CI -->
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.organization>nataliagarciab</sonar.organization>
		<sonar.projectKey>NataliaGarciaB_rtbc-orders-api</sonar.projectKey>
		<sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<!-- Mismas exclusiones que JaCoCo (ADR-013) para que ambas herramientas midan lo mismo -->
		<sonar.coverage.exclusions>**/RtbcOrdersApiApplication.java</sonar.coverage.exclusions>
		<!-- Karate 1.5.x: compatible con Java 17 (Karate 2.x requiere Java 21) -->
		<karate.version>1.5.2</karate.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<!-- Solo /actuator/health para el healthcheck del contenedor (ADR-021) -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<!-- Swagger UI estático: muestra el contrato de diseño sin generar otra especificación -->
			<groupId>org.webjars</groupId>
			<artifactId>swagger-ui</artifactId>
			<version>${swagger-ui.version}</version>
		</dependency>
		<dependency>
			<!-- Rutas /webjars/** sin versión; versión gestionada por Spring Boot -->
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-lite</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Requerido por pitest-junit5-plugin; versión alineada por el BOM de Spring Boot -->
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Solo el motor de Karate: el runner es una prueba JUnit propia (sin karate-junit5) -->
			<groupId>io.karatelabs</groupId>
			<artifactId>karate-core</artifactId>
			<version>${karate.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<!-- Ejecutar: ./mvnw verify sonar:sonar (requiere SONAR_TOKEN) -->
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<!-- Swagger UI publica el contrato de diseño tal cual: una sola fuente de verdad -->
				<directory>docs/api</directory>
				<includes>
					<include>openapi.yaml</include>
				</includes>
				<targetPath>static</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>${skipUnitTests}</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<skip>${skipUnitTests}</skip>
					<excludes>
						<!-- ADR-013: punto de arranque de Spring Boot, sin lógica propia -->
						<exclude>com/rtbc/orders/RtbcOrdersApiApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Ejecutar: ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage -->
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest-junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<!-- ADR-013: se muta donde vive la lógica de negocio -->
					<targetClasses>
						<param>com.rtbc.orders.domain.*</param>
						<param>com.rtbc.orders.application.*</param>
					</targetClasses>
					<targetTests>
						<param>com.rtbc.orders.domain.*</param>
						<param>com.rtbc.orders.application.*</param>
					</targetTests>
					<!-- STRONGER: más operadores que DEFAULTS; un score alto aquí es una señal más exigente -->
					<mutators>
						<mutator>STRONGER</mutator>
					</mutators>
					<mutationThreshold>${mutation.threshold}</mutationThreshold>
					<outputFormats>
						<param>HTML</param>
						<param>XML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<!--
				Pruebas de aceptación con Karate (Fase 4).
				Local:  ./mvnw verify -Pacceptance                  (levanta la app, corre Karate y la apaga)
				Docker: ./mvnw verify -Pacceptance -Dkarate.env=docker -Dacceptance.skipAppStart=true
				Filtro: -Dkarate.tags=@RN-05
			-->
			<id>acceptance</id>
			<properties>
				<acceptance.port>18080</acceptance.port>
				<acceptance.skipAppStart>false</acceptance.skipAppStart>
				<karate.env>local</karate.env>
				<karate.tags></karate.tags>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>start-app</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>start</goal>
								</goals>
								<configuration>
									<skip>${acceptance.skipAppStart}</skip>
									<arguments>
										<argument>--server.port=${acceptance.port}</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>stop-app</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>stop</goal>
								</goals>
								<configuration>
									<skip>${acceptance.skipAppStart}</skip>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<configuration>
							<includes>
								<include>**/*KarateIT.java</include>
							</includes>
							<systemPropertyVariables>
								<karate.env>${karate.env}</karate.env>
								<karate.tags>${karate.tags}</karate.tags>
								<acceptance.port>${acceptance.port}</acceptance.port>
							</systemPropertyVariables>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
